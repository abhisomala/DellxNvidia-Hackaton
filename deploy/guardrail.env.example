# Read by deploy/guardrail-dashboard.service from ~/.config/guardrail.env
GUARDRAIL_PORT=4173
GUARDRAIL_WATCH_INTERVAL_SECONDS=3600
MONGODB_URI=mongodb://127.0.0.1:27017
# The dashboard ran against scanner_test before consolidation; the pipeline CLI
# and DEMO.md default to the shared scanner database.
MONGODB_DATABASE=scanner_test
# Optional: generate patches through the OpenClaw agent in a NemoClaw/OpenShell sandbox
# (still Ollama gemma4:26b, routed by OpenShell). Unset or "ollama" = direct Ollama call.
# The unit's PATH must include the directory holding the nemoclaw CLI. See DEMO.md.
#GUARDRAIL_PATCH_BACKEND=nemoclaw
#GUARDRAIL_NEMOCLAW_SANDBOX=guardrail
#GUARDRAIL_NEMOCLAW_TIMEOUT_S=300
