{
  "name": "a11y-remediation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Path 2: drives an OpenClaw agent (local embedded, NemoClaw sandbox, or gateway) to fix one accessibility violation, then verifies it through five gates. Self-contained: includes a demo app and a stand-in scanner under fixtures/ for testing.",
  "bin": {
    "a11y-fix": "src/fix.mjs"
  },
  "devDependencies": {
    "openclaw": "2026.7.1",
    "node": "^24.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0"
  },
  "scripts": {
    "app": "vite --config fixtures/demo-app/vite.config.js fixtures/demo-app",
    "scan": "node fixtures/scanner/scan.mjs",
    "scan:raw": "node fixtures/scanner/axe-raw.mjs",
    "func": "node fixtures/scanner/functional.mjs",
    "fix": "node src/fix.mjs",
    "bench": "node src/bench.mjs",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "axe-core": "^4.13.0",
    "playwright": "1.56.0"
  },
  "engines": {
    "node": ">=22"
  }
}
